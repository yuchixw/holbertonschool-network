#!/usr/bin/env bash
# Configure an Ubuntu server to resolve localhost to 127.0.0.2 and facebook.com to 8.8.8.8

sudo sed -i '/localhost/d' /etc/hosts 2>/dev/null || true
sudo sed -i '/facebook.com/d' /etc/hosts 2>/dev/null || true

echo "127.0.0.2 localhost" | sudo tee -a /etc/hosts > /dev/null
echo "8.8.8.8 facebook.com" | sudo tee -a /etc/hosts > /dev/null
